# ---- 数据库 ----
DB_URL=jdbc:mysql://127.0.0.1:3307/ai_coding_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=platform123

# ---- JWT ----
# 生产环境必须使用 256-bit 以上强随机值：openssl rand -base64 32
JWT_SECRET=verification-test-secret-min-32bytes

# ---- Spring ----
SPRING_PROFILES_ACTIVE=
JAVA_OPTS=-Xmx512m

# ---- 模型网关 ----
MODEL_GATEWAY_PROVIDER=MOCK

# ---- OpenAI ----
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- DeepSeek ----
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Qwen ----
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ---- Claude ----
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ---- Gemini ----
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/oauth/callback
GITHUB_OAUTH_SCOPES=repo,read:user,user:email

# ---- Gateway Settings ----
MODEL_GATEWAY_TIMEOUT_MS=30000
MODEL_GATEWAY_RETRY_TIMES=1

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth Captcha ----
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_STORE=redis
AUTH_CAPTCHA_EXPIRE_SECONDS=120
AUTH_CAPTCHA_MAX_ATTEMPTS=3

# ---- Auth Login Protection ----
AUTH_LOGIN_PROTECTION_ENABLED=true
AUTH_LOGIN_MAX_EMAIL_FAILURES=5
AUTH_LOGIN_MAX_IP_FAILURES=20
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=600

# ---- Tool Worker Queue ----
TOOL_WORKER_MODE=SYNC_MOCK
TOOL_WORKER_QUEUE_ENABLED=false
TOOL_WORKER_ENABLED=false
TOOL_WORKER_EXCHANGE=tool.execution.exchange
TOOL_WORKER_QUEUE=tool.execution.queue
TOOL_WORKER_ROUTING_KEY=tool.execution.run
TOOL_WORKER_DEAD_LETTER_EXCHANGE=tool.execution.dlx
TOOL_WORKER_DEAD_LETTER_QUEUE=tool.execution.dlq
TOOL_WORKER_DEAD_LETTER_ROUTING_KEY=tool.execution.dead
TOOL_WORKER_MAX_RETRY_COUNT=2
TOOL_WORKER_RETRY_DELAYS_SECONDS=5,30,120
TOOL_WORKER_RUNNING_TIMEOUT_SECONDS=300
TOOL_WORKER_POLL_INTERVAL_MS=1500

# ---- Read-Only Tools ----
READ_ONLY_TOOL_MAX_FILE_BYTES=131072
READ_ONLY_TOOL_MAX_OUTPUT_BYTES=262144
READ_ONLY_TOOL_MAX_FILES=200
READ_ONLY_TOOL_REDACTION_ENABLED=true
READ_ONLY_TOOL_ALLOW_PREFIXES=backend/src,frontend/src,docs,scripts,deploy,.github/workflows

# ---- RabbitMQ ----
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_VIRTUAL_HOST=/
