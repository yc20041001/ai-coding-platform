# Production environment variables for AI Coding Platform
# =====================================================
# Copy this file to .env.production and replace ALL CHANGE_ME values.
# NEVER commit .env.production to version control.
#
#   cp .env.production.example .env.production
#   # Edit .env.production with real values
#
# Generate a strong JWT secret:
#   openssl rand -base64 32
# =====================================================

COMPOSE_PROJECT_NAME=ai-coding-platform-prod

# ---- Domain ----
APP_DOMAIN=example.com
APP_BASE_URL=https://example.com
APP_CORS_ALLOWED_ORIGINS=https://example.com

# ---- Ports ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MYSQL_HOST_PORT=3317

# ---- MySQL ----
MYSQL_DATABASE=ai_coding_platform
DB_URL=jdbc:mysql://mysql:3306/ai_coding_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD

# ---- JWT (REQUIRED: at least 32 characters) ----
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM

# ---- Spring ----
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# ---- Model Gateway ----
# Default provider for all AI calls: MOCK / OPENAI / CLAUDE / DEEPSEEK / QWEN / GEMINI
MODEL_GATEWAY_PROVIDER=MOCK
MODEL_GATEWAY_FALLBACK_ENABLED=true
MODEL_GATEWAY_TIMEOUT_MS=30000
MODEL_GATEWAY_RETRY_TIMES=1
MODEL_GATEWAY_PROMPT_SAFETY_ENABLED=true

# ---- OpenAI ----
# OPENAI_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- Claude (Anthropic) ----
# CLAUDE_ENABLED=true
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ---- DeepSeek ----
# DEEPSEEK_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Qwen (Tongyi Qianwen) ----
# QWEN_ENABLED=true
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# ---- Gemini (Google) ----
# GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://example.com/api/github/oauth/callback
GITHUB_OAUTH_SCOPES=read:user,user:email,repo

# ---- Smoke Test Config ----
# TEST_MODEL_PROVIDER=OPENAI
# TEST_MODEL_NAME=gpt-4.1-mini
# TEST_GITHUB_REPO_FULL_NAME=owner/repo
# TEST_GITHUB_PR_NUMBER=1

# ---- Docker Images (optional, for GHCR pulls) ----
# BACKEND_IMAGE=ghcr.io/yc20041001/ai-coding-platform-backend:latest
# FRONTEND_IMAGE=ghcr.io/yc20041001/ai-coding-platform-frontend:latest

# ---- SSL Certificates (for HTTPS mode) ----
# NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
